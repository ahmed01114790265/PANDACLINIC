@model PANDACLINIC.Web.Models.AccountViewModel.LoginPhoneVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5">
                    <h2 class="text-center mb-3">@Localizer["Header"]</h2>
                    <p class="text-center text-muted mb-4">@Localizer["Subtitle"]</p>

                    @if (ViewBag.PendingAddToCart == true)
                    {
                        <div class="alert alert-info">@Localizer["PendingCart"]</div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="AccountType" class="form-label">@Localizer["AccountType"]</label>
                            <select asp-for="AccountType" class="form-select js-account-type">
                                <option value="Customer">@Localizer["UserAccount"]</option>
                                <option value="Staff">@Localizer["StaffAccount"]</option>
                                <option value="Admin">@Localizer["AdminAccount"]</option>
                            </select>
                            <span asp-validation-for="AccountType" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 js-phone-field">
                            <label asp-for="PhoneNumber" class="form-label">@Localizer["Phone"]</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 js-email-field">
                            <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label" asp-for="RememberMe">@Localizer["RememberMe"]</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">@Localizer["Submit"]</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Register" class="text-decoration-none">@Localizer["RegisterLink"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const accountType = document.querySelector('.js-account-type');
            const phoneField = document.querySelector('.js-phone-field');
            const emailField = document.querySelector('.js-email-field');

            function syncCredentialField() {
                const isCustomer = accountType.value === 'Customer';
                phoneField.hidden = !isCustomer;
                emailField.hidden = isCustomer;
                phoneField.querySelector('input').disabled = !isCustomer;
                emailField.querySelector('input').disabled = isCustomer;
            }

            accountType.addEventListener('change', syncCredentialField);
            syncCredentialField();
        })();
    </script>
}
